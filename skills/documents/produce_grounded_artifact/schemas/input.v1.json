{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.documents.grounded-artifact.input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_version",
    "artifact_sha256",
    "session_id",
    "request_kind"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "request_kind": {
      "const": "GROUNDED_EVIDENCE_BRIEF"
    }
  }
}
