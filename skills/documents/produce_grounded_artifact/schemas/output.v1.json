{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.documents.grounded-artifact.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_status",
    "source_artifact_id",
    "source_artifact_version",
    "title",
    "sections",
    "unknowns",
    "conflicts"
  ],
  "properties": {
    "draft_status": {
      "const": "DRAFT"
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "source_artifact_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "claims"],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "claims": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "citations"],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "citations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "artifact_id",
                      "artifact_version",
                      "chunk_id",
                      "content_sha256",
                      "locator"
                    ],
                    "properties": {
                      "artifact_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                      },
                      "artifact_version": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                      },
                      "chunk_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,128}$"
                      },
                      "content_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "locator": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["page"],
                        "properties": {
                          "page": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10000
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  }
}
