# Co-Pilot Founder — environment template (see docs/01-architecture.md §env vars)
# Copy to .env and fill in. Never commit .env.

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global

# Default model for all agents (hackathon rules require Gemini 3.5+)
ADK_MODEL=gemini-3.5-flash
LIVE_MODEL=gemini-live-2.5-flash

# Founder-facing persona name — chat label + orchestrator voice (docs/adr/001)
PERSONA_NAME=Alex

# Sessions: local SQLite; prod = Cloud SQL asyncpg unix-socket URI
SESSION_SERVICE_URI=sqlite+aiosqlite:///sessions.db

# Artifacts: local files (MUST be absolute — ADK 2.7 rejects relative file:// URIs);
# prod = gs://<bucket>
ARTIFACT_SERVICE_URI=file:///absolute/path/to/artifacts

# Firestore pipeline store
FIRESTORE_DATABASE=(default)

# Active workflow definition
WORKFLOW_FILE=workflows/grant_applications.yaml

# Secrets fetched BY NAME via Secret Manager API at execution time (docs/12)
PORTAL_SECRET_NAME=mock-portal-creds
PORTAL_WEBHOOK_TOKEN_SECRET=portal-webhook-token

# Used by the mock portal to call the agent's webhooks
AGENT_BASE_URL=http://127.0.0.1:8090
MOCK_PORTAL_URL=http://127.0.0.1:8091

# Playwright headless (set false to watch the browser while developing)
HEADLESS=true

# General browsing policy (18). BROWSE_OPEN_WEB is a DEVELOPMENT convenience —
# .env.prod must omit it or set it false (production is fail-closed to the
# allowlist; scripts/deploy.sh asserts this).
BROWSE_OPEN_WEB=true
BROWSE_ALLOWED_DOMAINS=
BROWSE_BLOCKED_DOMAINS=

# Approval token lifetime
APPROVAL_TTL_MINUTES=30

# Google Workspace connectors (Drive + Gmail + Calendar, read-only) —
# connect via the Connectors panel (in-browser) or scripts/oauth_setup.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_TYPE=installed   # "installed" = Desktop client (local dev);
                                     # "web" = Web application client (works local + Cloud Run)
GOOGLE_OAUTH_REFRESH_TOKEN=

# Alex's mailbox (adr/001): connect via Connectors → Alex's Mailbox (sign in
# AS alex@ruhu.ai on the consent screen). ALEX_OAUTH_REFRESH_TOKEN is set by
# that flow; the two below enable push (Gmail watch → Pub/Sub → webhook).
ALEX_OAUTH_REFRESH_TOKEN=
ALEX_MAIL_PUBSUB_TOPIC=    # projects/<project>/topics/<topic>
ALEX_MAIL_WEBHOOK_TOKEN=   # shared secret checked on /webhooks/alex_mail
