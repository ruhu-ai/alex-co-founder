# Co-Pilot Founder — environment template (see docs/01-architecture.md §env vars)
# Copy to .env and fill in. Never commit .env.

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global

# Default model for all agents (hackathon rules require Gemini 3.5+)
ADK_MODEL=gemini-3.5-flash
LIVE_MODEL=gemini-live-2.5-flash

# Founder-facing persona name — chat label + orchestrator voice (docs/adr/001)
PERSONA_NAME=Alex

# Sessions: local SQLite; prod = Cloud SQL asyncpg unix-socket URI
SESSION_SERVICE_URI=sqlite+aiosqlite:///sessions.db

# Artifacts: local files (MUST be absolute — ADK 2.7 rejects relative file:// URIs);
# prod = gs://<bucket>
ARTIFACT_SERVICE_URI=file:///absolute/path/to/artifacts

# Firestore pipeline store
FIRESTORE_DATABASE=(default)

# Active workflow definition
WORKFLOW_FILE=workflows/grant_applications.yaml

# Secrets fetched BY NAME via Secret Manager API at execution time (docs/12)
PORTAL_SECRET_NAME=mock-portal-creds
PORTAL_WEBHOOK_TOKEN_SECRET=portal-webhook-token

# Used by the mock portal to call the agent's webhooks
AGENT_BASE_URL=http://127.0.0.1:8090
MOCK_PORTAL_URL=http://127.0.0.1:8091

# Playwright headless (set false to watch the browser while developing)
HEADLESS=true

# Approval token lifetime
APPROVAL_TTL_MINUTES=30

# Google Workspace connectors (Drive + Gmail, read-only) — scripts/oauth_setup.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
