# Co-Founder — environment template (see docs/01-architecture.md)
# Copy to .env and fill in local values. Never commit .env.

# Document 40 controlled founder-only artifact-analysis pilot. Every gate is
# default-off; the kill switch must also be explicitly cleared to claim work.
BACKGROUND_JOB_ADMISSION_ENABLED=false
BACKGROUND_SPECIALIST_EXECUTION_ENABLED=false
BACKGROUND_CONVERSATION_DELIVERY_ENABLED=false
BACKGROUND_ARTIFACT_PILOT_ENABLED=false
BACKGROUND_ARTIFACT_PILOT_EXECUTION_ENABLED=false
BACKGROUND_ARTIFACT_PILOT_KILL_SWITCH=true
BACKGROUND_ARTIFACT_PILOT_WORKSPACES=
BACKGROUND_ARTIFACT_PILOT_QUEUE=co-founder-background-pilot
TASKS_BACKGROUND_PILOT_SA=
BACKGROUND_PILOT_WORKLOAD_ALLOWLIST_JSON={}
BACKGROUND_PILOT_ALLOW_TEST_DISPATCH=0
BACKGROUND_PILOT_TEST_DISPATCH_SECRET=
BACKGROUND_SKILLS_ENABLED=false
BACKGROUND_ARTIFACT_PREPARATION_ENABLED=false
BACKGROUND_ARTIFACT_PREPARATION_EXECUTION_ENABLED=false
BACKGROUND_ARTIFACT_PREPARATION_KILL_SWITCH=true
BACKGROUND_ARTIFACT_PREPARATION_WORKSPACES=
BACKGROUND_ARTIFACT_PREPARATION_QUEUE=co-founder-background-skill-live-v1
TASKS_BACKGROUND_SKILL_SA=
BACKGROUND_SKILL_WORKLOAD_ALLOWLIST_JSON={}

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global

# Model assignments
ADK_MODEL=gemini-3.6-flash
REASONING_MODEL=gemini-3.6-flash
LITE_MODEL=gemini-3.5-flash-lite
LIVE_MODEL=gemini-live-2.5-flash
ALEX_LIVE_MAX_SESSION_SECONDS=840
ALEX_LIVE_IDLE_SECONDS=90
# Live visual sources fail closed. Enable the master gate and each reviewed
# source independently in the target environment.
ALEX_LIVE_VISION_ENABLED=false
ALEX_LIVE_CAMERA_ENABLED=false
ALEX_LIVE_DISPLAY_ENABLED=false

# Founder-facing persona
PERSONA_NAME=Alex

# Local persistence; production uses Cloud SQL and Cloud Storage.
SESSION_SERVICE_URI=sqlite+aiosqlite:///sessions.db
ARTIFACT_SERVICE_URI=file:///absolute/path/to/artifacts
FIRESTORE_DATABASE=(default)
WORKFLOW_FILE=workflows/grant_applications.yaml
# Phase 1 dual-write shadow. Enable only after the workflow migration dry-run
# and projection parity checks pass; it never originates provider effects.
WORKFLOW_RUNTIME_SHADOW=0
# One-time production provisioning input for scripts/seed_workspace_founder.py.
# This is the verified Firebase/OIDC `sub`, never an email address.
WORKSPACE_FOUNDER_SUBJECT=
WORKSPACE_ID=founder
WORKSPACE_FOUNDER_ACTOR_ID=member_founder
# Keep false for native macOS development. The Docker image explicitly enables
# its pinned headless Linux converter.
LIBREOFFICE_CONVERSION_ENABLED=false

# Secret Manager names are configuration; secret values stay blank here.
PORTAL_SECRET_NAME=mock-portal-creds
PORTAL_WEBHOOK_TOKEN=
APP_AUTH_TOKEN=

# Founder sign-in (email + Google) via Firebase Auth / Identity Platform
# (docs/12 §Founder sign-in). Add Firebase to the SAME GCP project, enable the
# Email/Password and Google providers, register a Web app, and copy its config
# here. The web API key is a public identifier, not a secret — the gate is the
# server-side token verification + allowlist. Leave blank to keep token-only.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
# Comma-separated emails allowed to sign in. Production fails closed when
# empty; local dev accepts any verified account. Workspace role is resolved
# separately and is never derived from this allowlist.
ALLOWED_LOGIN_EMAILS=
# Signs the login-session cookie; falls back to APP_AUTH_TOKEN.
APP_SESSION_SECRET=

AGENT_BASE_URL=http://127.0.0.1:8090
MOCK_PORTAL_URL=http://127.0.0.1:8091
# Cloud Tasks OIDC caller. scripts/deploy.sh injects the production value;
# leave blank only when using the in-process local dispatcher.
TASKS_INVOKER_SA=
TASKS_PROVIDER_EVENTS_SA=
TASKS_DISCOVERY_INGESTION_SA=
TASKS_TIMERS_SA=
TASKS_BROWSER_SA=
TASKS_RECONCILIATION_SA=
TASKS_INTERACTIVE_SA=

# Hiring H0-H3 is synthetic-only and off by default. Enabling the demo also
# requires an explicit comma-separated fixture-id allowlist; client-supplied
# `synthetic=true` is never authority. The encryption key is secret-managed by
# scripts/deploy.sh and must contain high-entropy fixture-only material.
# Every HIRING_* toggle below is enabled by the exact string 1 and by nothing
# else — "true" leaves the feature off.
HIRING_ENABLE_SYNTHETIC_DEMO=0
HIRING_SYNTHETIC_FIXTURE_IDS=
HIRING_SYNTHETIC_ENCRYPTION_KEY=
# Local-only staging gate for the public application form. This is always
# refused in Cloud Run, remains off by default, and needs an independent
# 64-hex-character key for encrypted local candidate intake. Production enablement
# requires a separately reviewed KMS/retention/abuse-control rollout.
HIRING_PUBLIC_INTAKE_LOCAL_ENABLED=0
HIRING_PUBLIC_INTAKE_LOCAL_KEY=
# Deployment generates this exact-route service-account allowlist. Local test
# dispatch instead uses HIRING_ALLOW_TEST_DISPATCH + a signed test principal.
HIRING_WORKLOAD_ALLOWLIST_JSON={}
HIRING_ALLOW_TEST_DISPATCH=0
HIRING_TEST_DISPATCH_SECRET=
HIRING_WORKSPACE_ID=workspace_founder
HIRING_FOUNDER_ACTOR_ID=member_founder
HIRING_FOUNDER_SUBJECT=
# H4S is an additive test-account-only sandbox. It never reads the ordinary
# Alex/founder Gmail or primary Calendar credentials above. Values name secrets
# whose contents are OAuth refresh tokens for distinct team-owned test accounts.
HIRING_ENABLE_H4_SANDBOX=0
HIRING_H4S_GMAIL_TEST_REFRESH_TOKEN_SECRET=
HIRING_H4S_CALENDAR_TEST_REFRESH_TOKEN_SECRET=
HIRING_H4S_GMAIL_TEST_ACCOUNT_SUBJECT_SHA256=
HIRING_H4S_CALENDAR_TEST_ACCOUNT_SUBJECT_SHA256=
# Team-controlled addresses only. H4S routes accept the destination kind and
# derive these server-side; never point them at ordinary founder/Alex accounts.
HIRING_H4S_TEST_CANDIDATE_ADDRESS=
HIRING_H4S_TEST_FOUNDER_ADDRESS=
HIRING_H4S_TEST_CALENDAR_ATTENDEE_ADDRESS=
HIRING_H4S_MAIL_PUBSUB_TOPIC=
# H4S worker routes share the single HIRING_WORKLOAD_ALLOWLIST_JSON map above;
# there is no separate H4S allowlist variable.

# A separately reviewed, clearly labelled internal demo lane. This is not H4S
# and is not live hiring. It permits only closed, exact-approved messages and
# Calendar effects between alex@ruhu.ai and ijidai@ruhu.ai plus one
# deployment-hash-pinned synthetic application imported manually from the
# configured fixture sender; no general mailbox search, watches, or generic tools.
HIRING_ENABLE_INTERNAL_CONTROLLED_DEMO=0
HIRING_INTERNAL_DEMO_ALEX_SUBJECT_SHA256=
HIRING_INTERNAL_DEMO_FOUNDER_SUBJECT_SHA256=
HIRING_INTERNAL_DEMO_APPLICATION_PDF_SHA256=

# Competition-safe conversational adapter. Keep false in production until its
# unit/integration tests and the full ADK eval gate pass.
DISCOVER_COMMAND_ENABLED=false

# Development-only browsing convenience. Production must use a strict allowlist.
BROWSE_OPEN_WEB=true
BROWSE_ALLOWED_DOMAINS=
BROWSE_BLOCKED_DOMAINS=
# Extra origins a credential-typing portal context may reach (IdP / verification
# hosts). The portal's own host is always allowed; everything else is refused so
# a hostile portal page cannot beacon a typed credential elsewhere (docs/22).
PORTAL_ALLOWED_HOSTS=
# Deployed API only: private Cloud Run origin for the Playwright owner. The
# worker instead sets BROWSER_WORKER_ROLE=1 and pins BROWSER_CALLER_SA to the
# API service identity. Local development leaves all three unset.
BROWSER_WORKER_URL=
BROWSER_WORKER_ROLE=0
BROWSER_CALLER_SA=

APPROVAL_TTL_MINUTES=30

# Google Workspace connectors. Complete OAuth through the in-app Connections
# panel or scripts/oauth_setup.py; never paste credentials into this template.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_TYPE=web
# Optional exact callback URI for founder Google login. When blank it is
# derived from AGENT_BASE_URL. Register the resulting
# <base>/auth/google/callback URI on the web OAuth client.
GOOGLE_LOGIN_REDIRECT_URI=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Alex's dedicated role account (alex@ruhu.ai). OAuth consent for alex_drive,
# alex_mail, and alex_calendar must resolve to this exact provider identity.
# Alex Drive requests Google's full Drive scope for this separate account;
# product-level writes still pass through reviewed approval/action receipts.
ALEX_ROLE_EMAIL=alex@ruhu.ai
ALEX_OAUTH_REFRESH_TOKEN=
ALEX_MAIL_PUBSUB_TOPIC=projects/your-project-id/topics/alex-mail-events
ALEX_MAIL_WEBHOOK_TOKEN=

# --- Gemma Evidence Checker (docs/20) — advisory semantic check on drafts ---
# Off until its labelled rollout eval passes. Uses managed Vertex MaaS with ADC;
# Google Cloud retention and data-governance controls apply. Only `vertex` is
# accepted; any other backend value is refused before a model request.
GEMMA_EVIDENCE_CHECK_ENABLED=false
GEMMA_EVIDENCE_BACKEND=vertex
GEMMA_EVIDENCE_VERTEX_MODEL=gemma-4-26b-a4b-it-maas
GEMMA_EVIDENCE_LEASE_SECONDS=90
# Phase 4 cutovers are explicit. Persistent memory never falls back to process
# memory; leave disabled until the offline memory gate and deletion review pass.
PROFILE_FACT_READ_MODE=compatibility
PERSISTENT_MEMORY_BACKEND=disabled
# Document 39 M1/M2 staged gates. These defaults authorize no rollout.
# M1 has no model or memory dependency. M2 additionally requires a comma-
# separated synthetic-workspace allowlist and an append-only Firestore database
# excluded from ordinary application restore. It must be a different named
# database from FIRESTORE_DATABASE; missing/ambiguous configuration fails closed.
DURABLE_BRIEF_M1_ENABLED=false
DURABLE_BRIEF_M1_WORKSPACE_ALLOWLIST=
DURABLE_MEMORY_M2_ENABLED=false
DURABLE_MEMORY_M2_WORKSPACE_ALLOWLIST=
MEMORY_DELETION_LEDGER_DATABASE=
DURABLE_MEMORY_BACKUP_RESIDUAL_DAYS=30
# M2 enablement refuses until Ops attests the actual backup-retention policy
# and records a non-secret policy/change reference. This is not inferred from
# the requested day count and does not itself alter backup configuration.
DURABLE_MEMORY_BACKUP_POLICY_ATTESTED=false
DURABLE_MEMORY_BACKUP_POLICY_REF=
INVESTOR_OUTREACH_ENABLED=1
