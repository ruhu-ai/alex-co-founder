# Co-Founder — environment template (see docs/01-architecture.md)
# Copy to .env and fill in local values. Never commit .env.

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global

# Model assignments
ADK_MODEL=gemini-3.6-flash
REASONING_MODEL=gemini-3.6-flash
LIVE_MODEL=gemini-live-2.5-flash

# Founder-facing persona
PERSONA_NAME=Alex

# Local persistence; production uses Cloud SQL and Cloud Storage.
SESSION_SERVICE_URI=sqlite+aiosqlite:///sessions.db
ARTIFACT_SERVICE_URI=file:///absolute/path/to/artifacts
FIRESTORE_DATABASE=(default)
WORKFLOW_FILE=workflows/grant_applications.yaml

# Secret Manager names are configuration; secret values stay blank here.
PORTAL_SECRET_NAME=mock-portal-creds
PORTAL_WEBHOOK_TOKEN=
APP_AUTH_TOKEN=

# Founder sign-in (email + Google) via Firebase Auth / Identity Platform
# (docs/12 §Founder sign-in). Add Firebase to the SAME GCP project, enable the
# Email/Password and Google providers, register a Web app, and copy its config
# here. The web API key is a public identifier, not a secret — the gate is the
# server-side token verification + allowlist. Leave blank to keep token-only.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
# Comma-separated emails allowed to act as the founder. Production fails
# closed when empty; local dev accepts any verified account.
ALLOWED_LOGIN_EMAILS=
# Signs the login-session cookie; falls back to APP_AUTH_TOKEN.
APP_SESSION_SECRET=

AGENT_BASE_URL=http://127.0.0.1:8090
MOCK_PORTAL_URL=http://127.0.0.1:8091

# Development-only browsing convenience. Production must use a strict allowlist.
BROWSE_OPEN_WEB=true
BROWSE_ALLOWED_DOMAINS=
BROWSE_BLOCKED_DOMAINS=

APPROVAL_TTL_MINUTES=30

# Google Workspace connectors. Complete OAuth through the in-app Connections
# panel or scripts/oauth_setup.py; never paste credentials into this template.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_TYPE=web
GOOGLE_OAUTH_REFRESH_TOKEN=

# Alex's dedicated role mailbox (alex@ruhu.ai).
ALEX_OAUTH_REFRESH_TOKEN=
ALEX_MAIL_PUBSUB_TOPIC=projects/your-project-id/topics/alex-mail-events
ALEX_MAIL_WEBHOOK_TOKEN=

# --- Gemma Evidence Checker (docs/20) — advisory semantic check on drafts ---
# Off until its labelled rollout eval passes. Uses managed Vertex MaaS with ADC;
# Google Cloud retention and data-governance controls apply. Only `vertex` is
# accepted; any other backend value is refused before a model request.
GEMMA_EVIDENCE_CHECK_ENABLED=false
GEMMA_EVIDENCE_BACKEND=vertex
GEMMA_EVIDENCE_VERTEX_MODEL=gemma-4-26b-a4b-it-maas
GEMMA_EVIDENCE_LEASE_SECONDS=90
