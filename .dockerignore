# Build-context excludes for `docker build .` / Cloud Build.
# The Dockerfile does `COPY . .`, so anything not excluded here is baked into
# the image layers. Keep ONLY runtime source: agents/ app/ services/
# scripts/ workflows/ (+ requirements.txt). Everything below is a secret,
# local state, cache, VCS artifact, doc, or large binary — never needed at
# runtime and, for the secret/state files, actively dangerous to ship.

# --- Secrets / credentials (NEVER bake into image layers) ---
.env
.env.*
!.env.example
.portal_secrets.json
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
credentials-*.json
client_secret*.json
service-account*.json
service_account*.json
gcp-key*.json
application_default_credentials.json
token.json
oauth-token*.json

# --- Local runtime state ---
sessions.db
*.db
*.db-*
*.sqlite
*.sqlite3
artifacts/
.extracted/
*.log
*.pid

# --- Virtualenv / VCS / editor / symlinks ---
.venv/
.git/
.gitignore
.github/
.DS_Store
~$*
.opensrc
.codex/
.idea/
.vscode/

# --- Build / test / tool caches ---
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.adk/
.coverage
.coverage.*
htmlcov/
coverage.xml
playwright-report/
test-results/
build/
dist/
*.egg-info/

# --- Tests (not imported at runtime) ---
tests/

# --- Docs & large binaries (only the release-bound Spec 39 contract ships) ---
docs/*
!docs/39-durable-cross-session-memory.md
*.pdf
ssh-lambda.docx

# --- The ignore file itself ---
.dockerignore
